GPIO5.associatedPins[11].$name = "S12";
GPIO5.associatedPins[11].direction = "INPUT";
GPIO5.associatedPins[11].pin.$assign = "PA16";

GPIO7.$name = "KEY";
GPIO7.associatedPins.create(4);
GPIO7.associatedPins[0].$name = "SW1";
GPIO7.associatedPins[0].direction = "INPUT";
GPIO7.associatedPins[0].internalResistor = "PULL_UP";
GPIO7.associatedPins[0].pin.$assign = "PB12";
