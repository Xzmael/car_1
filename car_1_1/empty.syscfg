GPIO7.associatedPins[3].pin.$assign = "PB15";

const GPIO6 = GPIO.addInstance();
GPIO6.$name = "MOTOR_DIR";
GPIO6.associatedPins.create(4);
GPIO6.associatedPins[0].$name = "AIN1";
GPIO6.associatedPins[0].pin.$assign = "PA2";
GPIO6.associatedPins[1].$name = "AIN2";
GPIO6.associatedPins[1].pin.$assign = "PA1";
GPIO6.associatedPins[2].$name = "BIN1";
GPIO6.associatedPins[2].pin.$assign = "PB20";
GPIO6.associatedPins[3].$name = "BIN2";
GPIO6.associatedPins[3].pin.$assign = "PB21";

PWM1.$name = "MOTOR_PWMA";
PWM1.timerCount = 1600;
PWM1.dutyArgs = "[50,0,0,0]";
PWM1.clockDivider = 1;
PWM1.clockPrescale = 1;
PWM1.ccIndex = [0];
PWM1.pwmMode = "EDGE_ALIGN_UP";
PWM1.peripheral.$assign = "TIMG7";
PWM1.peripheral.ccp0Pin.$assign = "PA28";
PWM1.PWM_CHANNEL_0.dutyCycle = 0;

PWM2.$name = "MOTOR_PWMB";
PWM2.timerCount = 1600;
PWM2.dutyArgs = "[0,50,0,0]";
PWM2.clockDivider = 1;
PWM2.clockPrescale = 1;
PWM2.ccIndex = [1];
PWM2.pwmMode = "EDGE_ALIGN_UP";
PWM2.peripheral.$assign = "TIMA1";
PWM2.peripheral.ccp1Pin.$assign = "PA11";
PWM2.PWM_CHANNEL_1.dutyCycle = 0;

I2C1.$name                     = "IMU_I2C";
I2C1.basicEnableController     = true;
I2C1.basicControllerBusSpeed   = 400000;
I2C1.peripheral.sclPin.$assign = "PA29";
I2C1.peripheral.sdaPin.$assign = "PA30";

GPIO8.$name                           = "IMU_INT1";
GPIO8.associatedPins[0].$name         = "INT1";
GPIO8.associatedPins[0].direction     = "INPUT";
GPIO8.associatedPins[0].interruptEn   = true;
GPIO8.associatedPins[0].interruptPriority = "3";
GPIO8.associatedPins[0].polarity      = "RISE";
GPIO8.associatedPins[0].pin.$assign   = "PB18";

SYSCTL.forceDefaultClkConfig = true;

/**
 * Pinmux solution for unlocked pins/peripherals. This ensures that minor changes to the automatic solver in a future
 * version of the tool will not impact the pinmux you originally saw.  These lines can be completely deleted in order to
 * re-solve from scratch.
 */
Board.peripheral.$suggestSolution          = "DEBUGSS";
Board.peripheral.swclkPin.$suggestSolution = "PA20";
Board.peripheral.swdioPin.$suggestSolution = "PA19";
I2C1.peripheral.$suggestSolution           = "I2C1";
I2C1.peripheral.sdaPin.$suggestSolution    = "PA30";
I2C1.peripheral.sclPin.$suggestSolution    = "PA29";
SYSCTL.peripheral.$suggestSolution         = "SYSCTL";
