GPIO7.associatedPins[1].direction = "INPUT";
GPIO7.associatedPins[1].internalResistor = "PULL_UP";
GPIO7.associatedPins[1].pin.$assign = "PB13";
GPIO7.associatedPins[2].$name = "SW3";
GPIO7.associatedPins[2].direction = "INPUT";
